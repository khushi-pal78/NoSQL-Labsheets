# Q5. Blogging Platform
create 'Blog', 'blog', 'author', 'comments'

# Blog 1
put 'Blog', 'B001', 'blog:title', 'Learning HBase'
put 'Blog', 'B001', 'blog:category', 'Technology'
put 'Blog', 'B001', 'blog:body', 'HBase stores data in rows and column families.'
put 'Blog', 'B001', 'author:name', 'Aman'
put 'Blog', 'B001', 'author:email', 'aman@example.com'
put 'Blog', 'B001', 'comments:C1', 'Very helpful'

# Blog 2
put 'Blog', 'B002', 'blog:title', 'Study Tips'
put 'Blog', 'B002', 'blog:category', 'Education'
put 'Blog', 'B002', 'blog:body', 'Plan your study time.'
put 'Blog', 'B002', 'author:name', 'Riya'
put 'Blog', 'B002', 'comments:C1', 'Nice tips'

# Blog 3
put 'Blog', 'B003', 'blog:title', 'Introduction to NoSQL'
put 'Blog', 'B003', 'blog:category', 'Database'
put 'Blog', 'B003', 'blog:body', 'NoSQL databases support flexible data models.'
put 'Blog', 'B003', 'author:name', 'Neha'
put 'Blog', 'B003', 'author:email', 'neha@example.com'

# Retrieve one blog by row key
get 'Blog', 'B002'

# Display all blogs
scan 'Blog'
